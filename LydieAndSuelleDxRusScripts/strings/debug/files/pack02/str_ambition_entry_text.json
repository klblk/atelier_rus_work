    "pack02:720975": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720975",
      "original": "Make another one of the Captain’s guns!",
      "translation": "Сделаем ещё одно ружьё Капитана!"
    },
    "pack02:720976": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720976",
      "original": "Collect portraits and display them in the room!",
      "translation": "Соберём портреты и повесим в комнате!"
    },
    "pack02:720977": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720977",
      "original": "Use fire to melt those Ice Spirits!",
      "translation": "Расплавим ледяных духов огнём!"
    },
    "pack02:720978": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720978",
      "original": "Burn those green Chromels to a crisp!",
      "translation": "Поджарим зелёные хромелы до хруста!"
    },
    "pack02:720979": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720979",
      "original": "Roast those rabbits from the snowy mountain!",
      "translation": "Поджарим кроликов с заснеженной горы!"
    },
    "pack02:720980": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720980",
      "original": "Light that large golem on fire!",
      "translation": "Подожжём того большого голема!"
    },
    "pack02:720981": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720981",
      "original": "Use some wood materials to repair roofs!",
      "translation": "Починим крыши деревянными материалами!"
    },
    "pack02:720982": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720982",
      "original": "Find a way to wipe up things without water!",
      "translation": "Найдём способ вытирать без воды!"
    },
    "pack02:720983": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720983",
      "original": "It’s a secret technique to fill holes with puniballs!",
      "translation": "Это секретная техника: затыкаем дыры пуниболами!"
    },
    "pack02:720984": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720984",
      "original": "Finish things off by covering it with mud!",
      "translation": "Завершим всё слоем грязи!"
    },
    "pack02:720985": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720985",
      "original": "Sew with gold colored thread?",
      "translation": "Прошьём золотой нитью?"
    },
    "pack02:720986": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720986",
      "original": "Find some stones with a wavelike pattern!",
      "translation": "Найдём камни с волнообразным узором!"
    },
    "pack02:720987": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720987",
      "original": "That Lava is incredibly hot!",
      "translation": "Эта лава невероятно горячая!"
    },
    "pack02:720988": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720988",
      "original": "Find some Raw Jet stones to make gems?",
      "translation": "Найдём сырой обсидиан для самоцветов?"
    },
    "pack02:720989": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720989",
      "original": "Make money with some gold colored stones!",
      "translation": "Заработаем на золотистых камнях!"
    },
    "pack02:720990": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720990",
      "original": "Collect some incredibly large animal bones!",
      "translation": "Соберём огромные кости животных!"
    },
    "pack02:720991": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720991",
      "original": "Follow after our teacher!",
      "translation": "Пойдём следом за наставником!"
    },
    "pack02:720992": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720992",
      "original": "Use alchemy to become even more famous!",
      "translation": "Станем ещё известнее с помощью алхимии!"
    },
    "pack02:720993": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720993",
      "original": "Give some delicious sweets to our teacher!",
      "translation": "Угостим наставника вкусными сладостями!"
    },
    "pack02:720994": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720994",
      "original": "Include a ribbon that suits her perfectly!",
      "translation": "Приложим идеально подходящую ленту!"
    },
    "pack02:720995": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720995",
      "original": "Also prepare some tea to go with the sweets!",
      "translation": "Ещё и чай к сладостям приготовим!"
    },
    "pack02:720996": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720996",
      "original": "Make an even more powerful bomb!",
      "translation": "Сделаем ещё более мощную бомбу!"
    },
    "pack02:720997": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720997",
      "original": "Become tough enough to defeat any monster!",
      "translation": "Станем достаточно сильными, чтобы победить любого монстра!"
    },
    "pack02:720998": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720998",
      "original": "Strike at the things hiding in the cauldron!",
      "translation": "Набросимся на тех, кто прячется в котле!"
    },
    "pack02:720999": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "720999",
      "original": "Smash the stone statue that flies in the air!",
      "translation": "Разнесём летающую каменную статую!"
    },
    "pack02:721000": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721000",
      "original": "Be careful to avoid being hit by the red sickle!",
      "translation": "Осторожно — чтобы красная коса не задела!"
    },
    "pack02:721001": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721001",
      "original": "Become the ultimate turtle crushers!",
      "translation": "Станем лучшими крушителями черепах!"
    },
    "pack02:721002": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721002",
      "original": "Defeat the mask-wearing puny!",
      "translation": "Победим Пунью в маске!"
    },
    "pack02:721003": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721003",
      "original": "Look for a crystal that isn’t broken!",
      "translation": "Найдём целый кристалл!"
    },
    "pack02:721004": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721004",
      "original": "Enjoy some delicious crab with our meal!",
      "translation": "Добавим к ужину вкусного краба!"
    },
    "pack02:721005": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721005",
      "original": "Take on a request and take control of the situation!",
      "translation": "Возьмём задание и ситуацию под контроль!"
    },
    "pack02:721006": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721006",
      "original": "Buy some information as well as items!",
      "translation": "Купим и информацию, и товары!"
    },
    "pack02:721007": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721007",
      "original": "Split up the tasks between us!",
      "translation": "Разделим задачи между собой!"
    },
    "pack02:721008": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721008",
      "original": "Examine the work of other ateliers!",
      "translation": "Осмотрим работы других ателье!"
    },
    "pack02:721009": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721009",
      "original": "Start with green and focus on quality!",
      "translation": "Начнём с зелёных — упор на качество!"
    },
    "pack02:721010": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721010",
      "original": "Follow up with some expensive-looking blue ones!",
      "translation": "Потом сделаем синие, дорогие на вид!"
    },
    "pack02:721011": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721011",
      "original": "Make some yellow ones to increase quality!",
      "translation": "Сделаем жёлтые для повышения качества!"
    },
    "pack02:721012": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721012",
      "original": "Finish with some red ones to keep up the quality!",
      "translation": "Завершим красными — качество не сбавляем!"
    },
    "pack02:721013": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721013",
      "original": "Fight the enemy without rest!",
      "translation": "Будем драться с врагами без передышки!"
    },
    "pack02:721014": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721014",
      "original": "Work on synthesis even when we’re sleeping!",
      "translation": "Будем синтезировать даже во сне!"
    },
    "pack02:721015": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721015",
      "original": "Concentrate on finding things!",
      "translation": "Сосредоточимся на поиске!"
    },
    "pack02:721016": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721016",
      "original": "Eat meat if we get hungry!",
      "translation": "Проголодаемся — съедим мяса!"
    },
    "pack02:721017": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721017",
      "original": "Increase our synthesis power!",
      "translation": "Усилим нашу силу синтеза!"
    },
    "pack02:721018": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721018",
      "original": "Make leather with alchemy!",
      "translation": "Сделаем дублёную кожу алхимией!"
    },
    "pack02:721019": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721019",
      "original": "Make some oil that allows to lose weight!",
      "translation": "Сделаем масло, чтобы худеть!"
    },
    "pack02:721020": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721020",
      "original": "Also make some purified water too!",
      "translation": "Заодно сделаем ещё очищенную воду!"
    },
    "pack02:721021": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721021",
      "original": "Catch the plant that flies in the sky!",
      "translation": "Поймаем растение, летающее в небе!"
    },
    "pack02:721022": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721022",
      "original": "It’s a black stone that looks like a tree!",
      "translation": "Это чёрный камень, похожий на дерево!"
    },
    "pack02:721023": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721023",
      "original": "I want to play with a fairy!",
      "translation": "Хочу поиграть с феей!"
    },
    "pack02:721024": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721024",
      "original": "Do the bad guys tend to have fangs?",
      "translation": "У злодеев, кажется, всегда есть клыки?"
    },
    "pack02:721025": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721025",
      "original": "Make friends with Mireille!",
      "translation": "Подружимся с Мирей!"
    },
    "pack02:721026": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721026",
      "original": "We don’t care about Mathias so much!",
      "translation": "Матиас нас не особо волнует!"
    },
    "pack02:721027": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721027",
      "original": "Take notes and boost our reputation!",
      "translation": "Заполним журнал и нарастим репутацию!"
    },
    "pack02:721028": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721028",
      "original": "Add a coat in order to strength the wall!",
      "translation": "Наденем плащ, чтобы укрепить стену!"
    },
    "pack02:721029": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721029",
      "original": "The Plant Oil makes our skin nice and soft!",
      "translation": "Растительное масло сделает кожу мягкой и нежной!"
    },
    "pack02:721030": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721030",
      "original": "Use Princess Grass to show how cute we are!",
      "translation": "Используем Принцессу травы, чтобы показать, какие мы милые!"
    },
    "pack02:721031": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721031",
      "original": "Use a Wascher to make our blood nice and healthy?",
      "translation": "Используем Вашер, чтобы кровь стала здоровой?"
    },
    "pack02:721032": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721032",
      "original": "Relieve stress by fighting monsters!",
      "translation": "Сбросим стресс, сражаясь с монстрами!"
    },
    "pack02:721033": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721033",
      "original": "Put up fliers all around the capital!",
      "translation": "Расклеим листовки по всей столице!"
    },
    "pack02:721034": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721034",
      "original": "Answer any and all requests!",
      "translation": "Выполним любые задания!"
    },
    "pack02:721035": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721035",
      "original": "Don’t forget to brush up on our synthesis skills!",
      "translation": "Не забудем подтянуть навыки синтеза!"
    },
    "pack02:721036": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721036",
      "original": "Gather all kinds of items!",
      "translation": "Соберём всё, что попадётся!"
    },
    "pack02:721037": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721037",
      "original": "Defeat these cute little beasts!",
      "translation": "Победим этих милых зверушек!"
    },
    "pack02:721038": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721038",
      "original": "It’s a fluffy bunny party!",
      "translation": "Устраиваем пушистую кроличью вечеринку!"
    },
    "pack02:721039": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721039",
      "original": "Looks like we’re eating mushroom stew tomorrow?",
      "translation": "Похоже, завтра у нас грибной суп?"
    },
    "pack02:721040": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721040",
      "original": "Pick these monstrous leaves in abundance!",
      "translation": "Нарвём этих чудовищных листьев с избытком!"
    },
    "pack02:721041": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721041",
      "original": "Make friends with Pamela!",
      "translation": "Подружимся с Памелой!"
    },
    "pack02:721042": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721042",
      "original": "Pay a visit to Hagel’s shop!",
      "translation": "Заглянем в лавку Хагеля!"
    },
    "pack02:721043": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721043",
      "original": "Go shopping in order to make some connections!",
      "translation": "Сходим по магазинам — заведём знакомства!"
    },
    "pack02:721044": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721044",
      "original": "Sell all kinds of items!",
      "translation": "Продадим всё, что угодно!"
    },
    "pack02:721045": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721045",
      "original": "Go outside and hop around!",
      "translation": "Выйдем на улицу и побегаем попрыгунчиком!"
    },
    "pack02:721046": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721046",
      "original": "Sneak up on the monsters!",
      "translation": "Подкрадёмся к монстрам!"
    },
    "pack02:721047": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721047",
      "original": "Use some affordable stone materials for our training!",
      "translation": "Потренируемся на доступных камнях!"
    },
    "pack02:721048": {
      "source": "pack02_text_en",
      "file": "str_ambition_entry_text.xml",
      "string_no": "721048",
      "original": "End things with a vicious and powerful staff strike!",
      "translation": "Завершим всё яростным ударом посохом!"
    }
  }
}
