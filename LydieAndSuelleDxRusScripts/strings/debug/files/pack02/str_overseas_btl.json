  "entries": {
    "pack02:52559873": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559873",
      "original": "I won't let you get away with this, humans!",
      "translation": "Я не позволю вам сойти с рук, люди!"
    },
    "pack02:52559875": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559875",
      "original": "I'll show you!",
      "translation": "Я покажу тебе!"
    },
    "pack02:52559877": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559877",
      "original": "Puny humans. This time, I will destroy you.",
      "translation": "Мелкие людишки. На этот раз я уничтожу тебя."
    },
    "pack02:52559878": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559878",
      "original": "We won't let you!",
      "translation": "Мы вам не позволим!"
    },
    "pack02:52559879": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559879",
      "original": "We've got something for you, after all!",
      "translation": "В конце концов, у нас есть кое-что для вас!"
    },
    "pack02:52559880": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559880",
      "original": "What?! You insolent...",
      "translation": "Что?! Ты наглый..."
    },
    "pack02:52559882": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559882",
      "original": "Burn! Turn to ash!",
      "translation": "Гореть! Превратитесь в пепел!"
    },
    "pack02:52559883": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559883",
      "original": "No! No matter how many times you try...",
      "translation": "Нет! Сколько бы раз ты ни пытался..."
    },
    "pack02:52559884": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559884",
      "original": "We won't give up!",
      "translation": "Мы не сдадимся!"
    },
    "pack02:52559885": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559885",
      "original": "You just don't learn... I will crush you!",
      "translation": "Ты просто не научишься... Я тебя раздавлю!"
    },
    "pack02:52559887": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559887",
      "original": "Let's go!",
      "translation": "Пойдем!"
    },
    "pack02:52559888": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559888",
      "original": "Let's go!",
      "translation": "Пойдем!"
    },
    "pack02:52559890": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559890",
      "original": "Fu-ha-ha-ha! Come at me!",
      "translation": "Фу-ха-ха-ха! Иди ко мне!"
    },
    "pack02:52559891": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559891",
      "original": "How could this...",
      "translation": "Как это могло..."
    },
    "pack02:52559893": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559893",
      "original": "I can do this.",
      "translation": "Я могу это сделать."
    },
    "pack02:52559894": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559894",
      "original": "Dizzy...",
      "translation": "Испытывающий головокружение..."
    },
    "pack02:52559896": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559896",
      "original": "We've got this, Fire Dragon!",
      "translation": "У нас есть это, Огненный Дракон!"
    },
    "pack02:52559897": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559897",
      "original": "Uh-oh, we lost...",
      "translation": "Ой-ой, мы проиграли..."
    },
    "pack02:52559899": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559899",
      "original": "I'll show you Hell!",
      "translation": "Я покажу тебе ад!"
    },
    "pack02:52559900": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559900",
      "original": "Play with me!",
      "translation": "Поиграй со мной!"
    },
    "pack02:52559901": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559901",
      "original": "I... lost...?",
      "translation": "Я потерял...?"
    },
    "pack02:52559902": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559902",
      "original": "Ugh, you win...",
      "translation": "Ух, ты выиграл..."
    },
    "pack02:52559904": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559904",
      "original": "Come on! Let's have fun!",
      "translation": "Ну давай же! Давайте веселиться!"
    },
    "pack02:52559905": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559905",
      "original": "Oh, I actually lost...",
      "translation": "Ох, я вообще проиграл..."
    },
    "pack02:52559907": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559907",
      "original": "Who dares to trespass?",
      "translation": "Кто посмеет нарушить границы?"
    },
    "pack02:52559908": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559908",
      "original": "You are capable, humans...",
      "translation": "Вы способны, люди..."
    },
    "pack02:52559910": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559910",
      "original": "How dare you stand against me?!",
      "translation": "Как ты смеешь противостоять мне?!"
    },
    "pack02:52559911": {
      "source": "pack02_text_en",
      "file": "str_overseas_btl.xml",
      "string_no": "52559911",
      "original": "No! I can't believe this!!",
      "translation": "Нет! Я не могу в это поверить!!"
    }
  }
